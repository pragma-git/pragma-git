[init]
    defaultbranch=main

[mergetool]
    keepBackup = false
    
[mergetool "pragma-git"]
    cmd = /opt/pragma-git/package.nw/pragma-merge $BASE $LOCAL $REMOTE $MERGED       
	trustExitCode = true    

[core]
    askpass = /opt/pragma-git/package.nw/pragma-askpass

[credential]
    useHttpPath = true
    
[push]
    autoSetupRemote = true
