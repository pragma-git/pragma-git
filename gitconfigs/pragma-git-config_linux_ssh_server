# app.js/setupSshServer()  copies this file to ".Pragma-git/pragma-git-config-ssh" 

[init]
    defaultbranch=main

[credential]
    useHttpPath = true
    helper = store      # Store credentials on server using git's file-based store mechanism. Is also hard-coded in ssh-git-client

    
[mergetool]
    keepBackup = false
    
[mergetool "pragma-git"]
    #cmd = /home/jan/Desktop/Pragma-git-dev/pragma-merge  "$BASE" "$LOCAL" "$REMOTE" "$MERGED" ssh
    cmd = $HOME/.Pragma-git/pragma-merge  "$BASE" "$LOCAL" "$REMOTE" "$MERGED" ssh
    trustExitCode = true    

[core]
    # Set this in the ssh-git-client
    # This is necessary because git does not expand $HOME for askpass (which is run as a command; not in a shell)
    # (it works for mergetool because it is executed in a shell by git)
    # For information -- this is the path in ssh-git-client (which is expanded there):
    # askpass = $HOME/.Pragma-git/pragma-askpass  

[push]
    autoSetupRemote = true
