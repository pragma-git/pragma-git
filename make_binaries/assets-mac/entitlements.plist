<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <!-- Tillåter V8-motorn att köra JIT-kompilering för JavaScript -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Tillåter NW.js att allokera osignerat minne (ett absolut krav för Chromium-arkitekturen) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Gör att NW.js kan ladda interna dylib-filer och Node-moduler (.node) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Tillåter att appen inspekteras/felsöks (hjälper Chromium-processerna att kommunicera) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Tillåter Chromium att mappa om minnessidor för sin V8-motor -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
