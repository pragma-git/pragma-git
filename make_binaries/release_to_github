#!/bin/bash
#
# This script builds a github release. 
#
# Requires 
#   0) Tag for pragma-git repo matches version from package.json
#   1) Run ./build on checked out tag
#   2) Modify the text in CHANGES below

# Changes section :

read -r -d '' CHANGES << ---
* **Integrated Conflict Resolver**: Built-in Pragma-merge with 2-way and 3-way visual resolution, single-click chunk adoption, and syntax highlighting.
* **Remote Repositories over SSH**: Control headless repositories directly from your desktop, with 1-click terminal and folder launch.
* **Scratchpad Commit Workflow**: Commit message box acts as an active scratchpad with auto-saved drafts per repository.
* **Live CI/CD Badges**: Real-time titlebar build status for GitHub Actions, GitLab CI, Bitbucket Pipelines, and Gitea.
* **Interactive Help Guide**: Live click-to-explain inspector in About & Help with search and visual previews.
* **Refreshed Themes**: Seamless high-contrast dark and light modes with instant switching.
* **Drag & Drop Setup**: Drop folders to open or initialize, or drop Git URLs to clone.
* **Privacy & Stability**: Zero external telemetry; full automated test coverage.
---

#
# --------------------------------------------------------------------------------------------
#

#
# Release text
#

# Tag to use for this Release (from package.json)
TAG=$(cat ../package.json | grep 'version' | cut -d'"' -f4)
echo "TAG = $TAG"

# Release Title from Tag
RELEASE_TITLE="Release $TAG"
echo "RELEASE_TITLE = $RELEASE_TITLE"

# Generate release text
read -r -d '' RELEASE_NOTES << '---'

### Downloads

[Windows](https://github.com/pragma-git/pragma-git/releases/latest/download/Pragma-git-win-x64.exe) |
[macOS (Intel)](https://github.com/pragma-git/pragma-git/releases/latest/download/Pragma-git-mac-x64.dmg) |
[macOS (Apple Silicon M1/M2/M3/M4)](https://github.com/pragma-git/pragma-git/releases/latest/download/Pragma-git-mac-arm64.dmg) |
[Linux (.deb)](https://github.com/pragma-git/pragma-git/releases/latest/download/Pragma-git-linux-x64.deb) |
[Linux (.rpm)](https://github.com/pragma-git/pragma-git/releases/latest/download/Pragma-git-linux-x64.rpm)

___
### About Pragma-git

Pragma-git is a compact, visual Git companion for daily programming:
- **Small & Non-Obtrusive**: Lives right beside your editor or in your tray without taking over your screen.
- **Visual Swim-Lines**: Clean, untangled branch graphs that make repository history effortless to read.
- **Built-in Power**: Integrated visual merge tool (Pragma-merge), remote SSH server control, and dedicated repository notes.
- **Friendly & Safe**: Proactively guards against detached HEAD pitfalls, uncommitted changes, and data loss.

📖 Learn more at [pragma-git.github.io](https://pragma-git.github.io)

___
### What's New in 2.0.1

$CHANGES

___
### Install

* **Windows**: Run the `.exe` installer.
* **macOS**: Open the `.dmg` and drag Pragma-git to Applications (see `README.txt` on disk image).
* **Linux**: [Read Linux terminal installation instructions](https://pragma-git.github.io#download)

---
# Substitute variables in RELEASE_NOTES manually because heredoc delimiter is quoted
RELEASE_NOTES="${RELEASE_NOTES//\$CHANGES/$CHANGES}"
RELEASE_NOTES="${RELEASE_NOTES//\$TAG/$TAG}"




# NOTE : If header name in https://pragma-git.github.io is changed, its element id will be changed.  
# Link points to "#download" on https://pragma-git.github.io.


TOKEN_FILE="../../mytoken.txt"  #NOTE: Token requires scopes: repos, write:packages, admin:org, and maybe user
REPO=pragma-git/pragma-git

#
# Create Release and Upload binaries
#

    # Login
    echo 'LOG IN TO GITHUB'
    gh auth login --with-token < "$TOKEN_FILE"
    #gh auth login --web
    
    # Create Release
    echo 'CREATE RELEASE'
    gh release create \
      $TAG \
      --repo "$REPO" \
      --draft \
      --notes "$RELEASE_NOTES" \
      --title "$RELEASE_TITLE"
      
    sleep 2  
      
    #exit 0 # Stop here to test without uploading files
      
    # Upload binaries (with clean unversioned names for permanent /latest/ links)
    echo 'UPLOAD BINARIES'
    cd '/Users/jan/Documents/Projects/Pragma-git/dist/'

    echo 'UPLOAD MAC (INTEL)'
    cp "mac/Pragma-git-$TAG-mac-x64.dmg" "mac/Pragma-git-mac-x64.dmg"
    gh release upload "$TAG" --repo "$REPO" "mac/Pragma-git-mac-x64.dmg" --clobber
    rm "mac/Pragma-git-mac-x64.dmg"
    
    echo 'UPLOAD MAC (ARM)'
    cp "mac_arm64/Pragma-git-$TAG-mac-arm64.dmg" "mac_arm64/Pragma-git-mac-arm64.dmg"
    gh release upload "$TAG" --repo "$REPO" "mac_arm64/Pragma-git-mac-arm64.dmg" --clobber
    rm "mac_arm64/Pragma-git-mac-arm64.dmg"
    
    echo 'UPLOAD WINDOWS'
    cp "win64/Pragma-git-$TAG-win-x64.exe" "win64/Pragma-git-win-x64.exe"
    gh release upload "$TAG" --repo "$REPO" "win64/Pragma-git-win-x64.exe" --clobber
    rm "win64/Pragma-git-win-x64.exe"
    
    echo 'UPLOAD LINUX DEB'
    cp "linux64/Pragma-git-$TAG-linux-x64.deb" "linux64/Pragma-git-linux-x64.deb"
    gh release upload "$TAG" --repo "$REPO" "linux64/Pragma-git-linux-x64.deb" --clobber
    rm "linux64/Pragma-git-linux-x64.deb"
    
    echo 'UPLOAD LINUX RPM'
    cp "linux64/Pragma-git-$TAG-linux-x64.rpm" "linux64/Pragma-git-linux-x64.rpm"
    gh release upload "$TAG" --repo "$REPO" "linux64/Pragma-git-linux-x64.rpm" --clobber
    rm "linux64/Pragma-git-linux-x64.rpm" 

#
# DONE
#
    echo ' '
    echo '=====' 
    echo 'DONE '
    echo '====='     

    read -n 1 -s -r -p "DONE : Press any key to continue" && echo ' '
