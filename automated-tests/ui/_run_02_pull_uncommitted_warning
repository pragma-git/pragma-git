#!/bin/bash
# _run_02_pull_uncommitted_warning - UI test for diverged remote repo, pull warning on uncommitted changes, and push dialog options
#
# Usage:
#   _run_02_pull_uncommitted_warning [OPTIONS]
#
# Description:
#   Runs the '02_pull_uncommitted_warning' UI test scenario via Chrome DevTools Protocol (CDP).
#   Tests against an actual remote repository in a diverged state (ahead and behind):
#     1. Clicking Pull with uncommitted changes triggers the uncommitted changes warning.
#     2. Clicking Push when behind remote triggers the diverged options dialog (pull vs force push).
#
# Options:
#   -h, --help        Show this help text and exit
#   --step, -i        Interactive step-by-step mode (pause before each action)
#   --port=<num>      CDP remote debugging port (default: 9333)
#   --clean-up        Clean up temporary test artifacts upon completion (stores artifacts if omitted)
#
# Examples:
#   ./_run_02_pull_uncommitted_warning            Run test_02_pull_uncommitted_warning scenario (stores artifacts)
#   ./_run_02_pull_uncommitted_warning --clean-up Run test_02_pull_uncommitted_warning and clean up artifacts
#   ./_run_02_pull_uncommitted_warning --step     Run test_02_pull_uncommitted_warning scenario with interactive step prompts
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

exec node "$SCRIPT_DIR/scenarios/test_02_pull_uncommitted_warning.js" "$@"
