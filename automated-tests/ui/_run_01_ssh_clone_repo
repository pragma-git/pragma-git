#!/bin/bash
# _run_01_ssh_clone_repo - UI test for SSH remote repository cloning in Pragma-git
#
# Usage:
#   _run_01_ssh_clone_repo [OPTIONS]
#
# Description:
#   Runs the '01_ssh_clone_repo' UI test scenario via Chrome DevTools Protocol (CDP).
#   Tests testing SSH connection, deploying SSH key, and cloning a remote repository.
#
# Options:
#   -h, --help       Show this help text and exit
#   --step, -i       Interactive step-by-step mode (pause before each action)
#   --port=<num>     CDP remote debugging port (default: 9333)
#   --keep-artifacts Keep test directories and cloned repos after test finishes
#
# Examples:
#   ./_run_01_ssh_clone_repo          Run test_01_ssh_clone_repo scenario automatically
#   ./_run_01_ssh_clone_repo --step   Run test_01_ssh_clone_repo scenario with interactive step prompts
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

exec node "$SCRIPT_DIR/scenarios/test_01_ssh_clone_repo.js" "$@"
