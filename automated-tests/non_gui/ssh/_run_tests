#!/bin/bash
# _run_tests - SSH non-GUI automated test runner for Pragma-git
#
# Usage:
#   _run_tests [OPTIONS]
#
# Description:
#   Runs automated SSH test suites against localhost. Tests cover passwordless
#   login, key validation, error handling, remote folder verification, remote
#   directory creation (including spaces), git commands over SSH, and file transfers.
#
# Options:
#   -h, --help       Show this help text and exit
#   -v, --verbose    Show detailed live output from each test
#
# Examples:
#   ./_run_tests                  Run all SSH tests (concise mode)
#   ./_run_tests -v               Run all SSH tests with live verbose output
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

source "$REPO_ROOT/automated-tests/test_setup.sh"

VERBOSE=false
for arg in "$@"; do
    case "$arg" in
        -h|--help|'/?')
            sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            export VERBOSE=true
            ;;
    esac
done

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}${CYAN}      Pragma-git Automated Tests: SSH Integration (Non-GUI)${NORMAL}"
echo "${BOLD}======================================================================${NORMAL}"
echo "Running on: $(uname -s) ($(uname -m)) as user '$USER'"
function print_suite_description() {
    local file="$1"
    case "$file" in
        test_01_ssh_login.sh)
            echo "   Verifies passwordless SSH login to localhost using standard and custom keys."
            echo "   Tests error handling for rejected keys (KEY_NEEDED), invalid hosts, and ports."
            ;;
        test_02_ssh_folder_validation.sh)
            echo "   Validates ssh-test-if-file-exists detection of existing/missing remote folders."
            echo "   Tests detection of Git repositories by checking for remote .git directories."
            ;;
        test_03_ssh_mkdir.sh)
            echo "   Tests remote folder creation via ssh-mkdir, including nested dirs (mkdir -p)."
            echo "   Verifies idempotent creation and handles paths containing spaces properly."
            ;;
        test_04_ssh_git_client.sh)
            echo "   Tests ssh-git-client tunneling for git init, status, add, commit, and log."
            echo "   Verifies branch creation and switching over SSH without local Git mounting."
            ;;
        test_05_ssh_put_get.sh)
            echo "   Tests ssh-put file uploads and ssh-get file downloads to/from SSH server."
            echo "   Validates data payload integrity, remote content modifications, and round-trips."
            ;;
        test_06_ssh_lib_node.js)
            echo "   Tests Node.js helper methods in ssh-folder-lib.js for resolving SSH identities."
            echo "   Verifies ~/.ssh key scanning, fallback selection, and WSL path conversions."
            ;;
    esac
}

echo "Test dir  : $SCRIPT_DIR"
echo "Started at: $(date '+%Y-%m-%d %H:%M:%S %Z')"
[ "$VERBOSE" = true ] && echo "Verbosity : Detailed (-v)"
echo ""

START_TIME=$(date +%s)
TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

# On Windows, ensure WSL ssh daemon is active for tests
if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]] && command -v wsl >/dev/null 2>&1; then
    wsl -u root service ssh restart >/dev/null 2>&1 || true
fi

TEST_FILES=($(find "$SCRIPT_DIR" -maxdepth 1 -type f \( -name "test_*.sh" -o -name "test_*.js" \) | sort))
NUM_TESTS=${#TEST_FILES[@]}

CATEGORY_NAME=$(basename "$SCRIPT_DIR")

for test_path in "${TEST_FILES[@]}"; do
    test_name=$(basename "$test_path")
    suite_title="${CATEGORY_NAME}/${test_name}"
    ((TOTAL_TESTS++))

    if [ "$VERBOSE" = true ]; then
        echo "${BOLD}----------------------------------------------------------------------${NORMAL}"
        echo "${BOLD}>> Suite $TOTAL_TESTS/$NUM_TESTS: ${suite_title}${NORMAL}"
        print_suite_description "$test_name"
        echo ""

        if [[ "$test_path" == *.js ]]; then
            (cd "$SCRIPT_DIR" && node "$test_name")
        elif [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]] && command -v wsl >/dev/null 2>&1; then
            wsl_path=$(echo "$test_path" | sed -E 's|^/([a-zA-Z])/|/mnt/\1/|')
            MSYS_NO_PATHCONV=1 wsl -u "${CURRENT_USER:-runneradmin}" bash "$wsl_path"
        else
            bash "$test_path"
        fi
        exit_code=$?

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            echo "${GREEN}${BOLD}>> Result: SUITE PASSED [OK]${NORMAL}"
        else
            ((FAILED_TESTS++))
            echo "${RED}${BOLD}>> Result: SUITE FAILED [XX]${NORMAL}"
        fi
        echo ""
    else
        printf ">> [%d/%d] %-46s " "$TOTAL_TESTS" "$NUM_TESTS" "$suite_title"

        if [[ "$test_path" == *.js ]]; then
            OUTPUT=$(cd "$SCRIPT_DIR" && node "$test_name" 2>&1)
        elif [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]] && command -v wsl >/dev/null 2>&1; then
            wsl_path=$(echo "$test_path" | sed -E 's|^/([a-zA-Z])/|/mnt/\1/|')
            OUTPUT=$(MSYS_NO_PATHCONV=1 wsl -u "${CURRENT_USER:-runneradmin}" bash "$wsl_path" 2>&1)
        else
            OUTPUT=$(bash "$test_path" 2>&1)
        fi
        exit_code=$?

        pass_count=$(echo "$OUTPUT" | grep -c '\[PASS\]')
        fail_count=$(echo "$OUTPUT" | grep -c '\[FAIL\]')
        total_count=$((pass_count + fail_count))

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            echo "${GREEN}[OK]${NORMAL} (${pass_count}/${total_count} passed)"
        else
            ((FAILED_TESTS++))
            echo "${RED}[FAILED]${NORMAL} (${pass_count}/${total_count} passed, ${fail_count} failed)"
            echo ""
            echo "${RED}${BOLD}--- Failure Output for ${test_name} ---${NORMAL}"
            echo "$OUTPUT"
            echo "${RED}${BOLD}----------------------------------------${NORMAL}"
            echo ""
        fi
    fi
done

[ "$VERBOSE" = false ] && echo ""
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}SSH Test Summary:${NORMAL}"
echo "  Suites run:    $TOTAL_TESTS"
echo "  Suites passed: ${GREEN}$PASSED_TESTS/$TOTAL_TESTS passed${NORMAL}"
if [ $FAILED_TESTS -gt 0 ]; then
    echo "  Suites failed: ${RED}$FAILED_TESTS${NORMAL}"
else
    echo "  Suites failed: $FAILED_TESTS"
fi
echo "  Duration:      ${DURATION}s"
echo "${BOLD}======================================================================${NORMAL}"

if [ $FAILED_TESTS -eq 0 ] && [ $TOTAL_TESTS -gt 0 ]; then
    echo "${GREEN}${BOLD}ALL SSH TESTS PASSED!${NORMAL}"
    exit 0
else
    echo "${RED}${BOLD}SOME SSH TESTS FAILED!${NORMAL}"
    exit 1
fi
