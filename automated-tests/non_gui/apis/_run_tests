#!/bin/bash
# _run_tests - Git provider REST API mapping test runner for Pragma-git
#
# Usage:
#   _run_tests [OPTIONS]
#
# Description:
#   Runs automated tests for GitHub, GitLab, and Bitbucket provider classes
#   in apis_github_and_others, verifying git-to-API URL conversions, credential
#   sanitization, and provider initialization.
#
# Options:
#   -h, --help       Show this help text and exit
#   -v, --verbose    Show detailed live output from each test
#
# Examples:
#   ./_run_tests                  Run all APIs tests (concise mode)
#   ./_run_tests -v               Run all APIs tests with live verbose output
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

source "$REPO_ROOT/automated-tests/test_setup.sh"

VERBOSE=false
for arg in "$@"; do
    case "$arg" in
        -h|--help|'/?')
            sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            export VERBOSE=true
            ;;
    esac
done

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}${CYAN}      Pragma-git Automated Tests: Git Provider APIs (Non-GUI)${NORMAL}"
echo "${BOLD}======================================================================${NORMAL}"
echo "Running on: $(uname -s) ($(uname -m)) as user '$USER'"
function print_suite_description() {
    local file="$1"
    case "$file" in
        test_01_provider_url_translation.js)
            echo "   Tests provider classes (GitHub, GitLab, Bitbucket) translating git URLs to REST APIs."
            echo "   Verifies automatic stripping of credentials from REST endpoints and slug parsing."
            ;;
        test_02_live_provider_query.js)
            echo "   Checks network connectivity, then tests live public queries against GitHub & Bitbucket."
            echo "   Verifies git ls-remote over HTTPS against official repos (GitHub, GitLab, Bitbucket)."
            ;;
        test_03_provider_classes.js)
            echo "   Tests provider class instantiation and static getters across GitHub, GitLab, and Bitbucket."
            echo "   Verifies General_git_rest_api base methods and provider-specific icon and username extraction."
            ;;
    esac
}

echo "Test dir  : $SCRIPT_DIR"
echo "Started at: $(date '+%Y-%m-%d %H:%M:%S %Z')"
[ "$VERBOSE" = true ] && echo "Verbosity : Detailed (-v)"
echo ""

START_TIME=$(date +%s)
TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

export NODE_PATH="$REPO_ROOT"
TEST_FILES=($(find "$SCRIPT_DIR" -maxdepth 1 -type f \( -name "test_*.sh" -o -name "test_*.js" \) | sort))
NUM_TESTS=${#TEST_FILES[@]}

CATEGORY_NAME=$(basename "$SCRIPT_DIR")

for test_path in "${TEST_FILES[@]}"; do
    test_name=$(basename "$test_path")
    suite_title="${CATEGORY_NAME}/${test_name}"
    ((TOTAL_TESTS++))

    if [ "$VERBOSE" = true ]; then
        echo "${BOLD}----------------------------------------------------------------------${NORMAL}"
        echo "${BOLD}>> Suite $TOTAL_TESTS/$NUM_TESTS: ${suite_title}${NORMAL}"
        print_suite_description "$test_name"
        echo ""

        if [[ "$test_path" == *.js ]]; then
            node "$test_path"
        else
            bash "$test_path"
        fi
        exit_code=$?

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            echo "${GREEN}${BOLD}>> Result: SUITE PASSED [OK]${NORMAL}"
        else
            ((FAILED_TESTS++))
            echo "${RED}${BOLD}>> Result: SUITE FAILED [XX]${NORMAL}"
        fi
        echo ""
    else
        printf ">> [%d/%d] %-46s " "$TOTAL_TESTS" "$NUM_TESTS" "$suite_title"

        if [[ "$test_path" == *.js ]]; then
            OUTPUT=$(node "$test_path" 2>&1)
        else
            OUTPUT=$(bash "$test_path" 2>&1)
        fi
        exit_code=$?

        pass_count=$(echo "$OUTPUT" | grep -c '\[PASS\]')
        fail_count=$(echo "$OUTPUT" | grep -c '\[FAIL\]')
        total_count=$((pass_count + fail_count))

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            echo "${GREEN}[OK]${NORMAL} (${pass_count}/${total_count} passed)"
        else
            ((FAILED_TESTS++))
            echo "${RED}[FAILED]${NORMAL} (${pass_count}/${total_count} passed, ${fail_count} failed)"
            echo ""
            echo "${RED}${BOLD}--- Failure Output for ${test_name} ---${NORMAL}"
            echo "$OUTPUT"
            echo "${RED}${BOLD}----------------------------------------${NORMAL}"
            echo ""
        fi
    fi
done

[ "$VERBOSE" = false ] && echo ""
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}APIs Test Summary:${NORMAL}"
echo "  Suites run:    $TOTAL_TESTS"
echo "  Suites passed: ${GREEN}$PASSED_TESTS/$TOTAL_TESTS passed${NORMAL}"
if [ $FAILED_TESTS -gt 0 ]; then
    echo "  Suites failed: ${RED}$FAILED_TESTS${NORMAL}"
else
    echo "  Suites failed: $FAILED_TESTS"
fi
echo "  Duration:      ${DURATION}s"
echo "${BOLD}======================================================================${NORMAL}"

if [ $FAILED_TESTS -eq 0 ] && [ $TOTAL_TESTS -gt 0 ]; then
    echo "${GREEN}${BOLD}ALL APIS TESTS PASSED!${NORMAL}"
    exit 0
else
    echo "${RED}${BOLD}SOME APIS TESTS FAILED!${NORMAL}"
    exit 1
fi
