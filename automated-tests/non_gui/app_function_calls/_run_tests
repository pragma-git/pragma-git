#!/bin/bash
# _run_tests - Main application logic test runner for Pragma-git
#
# Usage:
#   _run_tests [OPTIONS]
#
# Description:
#   Runs automated tests for non-GUI business logic and utility functions
#   residing in app.js (repo settings normalization, date & history formatting,
#   type of repo server detection, decimal and string validators).
#
# Options:
#   -h, --help       Show this help text and exit
#   -v, --verbose    Show detailed live output from each test
#
# Examples:
#   ./_run_tests                  Run all app function tests (concise mode)
#   ./_run_tests -v               Run all app function tests with live verbose output
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

BOLD=$(tput bold 2>/dev/null || echo "")
NORMAL=$(tput sgr0 2>/dev/null || echo "")
GREEN=$(tput setaf 2 2>/dev/null || echo "")
RED=$(tput setaf 1 2>/dev/null || echo "")
CYAN=$(tput setaf 6 2>/dev/null || echo "")

VERBOSE=false
for arg in "$@"; do
    case "$arg" in
        -h|--help|'/?')
            sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            export VERBOSE=true
            ;;
    esac
done

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}${CYAN}      Pragma-git Automated Tests: App Function Calls (Non-GUI)${NORMAL}"
echo "${BOLD}======================================================================${NORMAL}"
echo "Running on: $(uname -s) ($(uname -m)) as user '$USER'"

function print_suite_description() {
    local file="$1"
    case "$file" in
        test_01_repo_settings.js)
            echo "   Tests repository configuration repair and validation helpers from app.js."
            echo "   Verifies fixRepoSettingWithDefault, isDecimal, and isNullOrWhitespace."
            ;;
        test_02_history_message.js)
            echo "   Tests commit history message formatting and timestamp parsing from app.js."
            echo "   Verifies formatHistoryMessage with ISO dates, multi-line bodies, and line separators."
            ;;
    esac
}

echo "Test dir  : $SCRIPT_DIR"
[ "$VERBOSE" = true ] && echo "Verbosity : Detailed (-v)"
echo ""

START_TIME=$(date +%s)
TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

TEST_FILES=($(find "$SCRIPT_DIR" -maxdepth 1 -type f \( -name "test_*.sh" -o -name "test_*.js" \) | sort))
NUM_TESTS=${#TEST_FILES[@]}

CATEGORY_NAME=$(basename "$SCRIPT_DIR")

for test_path in "${TEST_FILES[@]}"; do
    test_name=$(basename "$test_path")
    suite_title="${CATEGORY_NAME}/${test_name}"
    ((TOTAL_TESTS++))

    if [ "$VERBOSE" = true ]; then
        echo "${BOLD}----------------------------------------------------------------------${NORMAL}"
        echo "${BOLD}>> Suite $TOTAL_TESTS/$NUM_TESTS: ${suite_title}${NORMAL}"
        print_suite_description "$test_name"
        echo ""

        if [[ "$test_path" == *.js ]]; then
            node "$test_path"
        else
            bash "$test_path"
        fi
        exit_code=$?

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            echo "${GREEN}${BOLD}>> Result: SUITE PASSED [OK]${NORMAL}"
        else
            ((FAILED_TESTS++))
            echo "${RED}${BOLD}>> Result: SUITE FAILED [XX]${NORMAL}"
        fi
        echo ""
    else
        printf ">> [%d/%d] %-46s " "$TOTAL_TESTS" "$NUM_TESTS" "$suite_title"

        if [[ "$test_path" == *.js ]]; then
            OUTPUT=$(node "$test_path" 2>&1)
            exit_code=$?
        else
            OUTPUT=$(bash "$test_path" 2>&1)
            exit_code=$?
        fi

        PASSED_COUNT=$(echo "$OUTPUT" | grep -o 'PASSED [0-9]*/[0-9]*' | tail -1 | awk '{print $2}')
        if [ -z "$PASSED_COUNT" ]; then
            PASSED_COUNT=$(echo "$OUTPUT" | grep -c "PASS:")
            TOTAL_IN_SUITE=$(echo "$OUTPUT" | grep -c -E "(PASS|FAIL):")
            if [ "$TOTAL_IN_SUITE" -gt 0 ]; then
                PASSED_COUNT="${PASSED_COUNT}/${TOTAL_IN_SUITE}"
            fi
        fi

        if [ $exit_code -eq 0 ]; then
            ((PASSED_TESTS++))
            if [ -n "$PASSED_COUNT" ]; then
                printf "${GREEN}[OK] (%s passed)${NORMAL}\n" "$PASSED_COUNT"
            else
                printf "${GREEN}[OK]${NORMAL}\n"
            fi
        else
            ((FAILED_TESTS++))
            if [ -n "$PASSED_COUNT" ]; then
                printf "${RED}[FAIL] (%s passed)${NORMAL}\n" "$PASSED_COUNT"
            else
                printf "${RED}[FAIL]${NORMAL}\n"
            fi
        fi
    fi
done

DURATION=$(( $(date +%s) - START_TIME ))

echo ""
echo "${BOLD}======================================================================${NORMAL}"
echo "App Function Calls Test Summary:"
echo "  Suites run:    $TOTAL_TESTS"
echo "  Suites passed: ${PASSED_TESTS}/${TOTAL_TESTS} passed"
echo "  Suites failed: $FAILED_TESTS"
echo "  Duration:      ${DURATION}s"
echo "${BOLD}======================================================================${NORMAL}"

if [ $FAILED_TESTS -eq 0 ]; then
    echo "${GREEN}${BOLD}ALL APP FUNCTION CALLS TESTS PASSED!${NORMAL}"
    exit 0
else
    echo "${RED}${BOLD}SOME APP FUNCTION CALLS TESTS FAILED!${NORMAL}"
    exit 1
fi
