#!/bin/bash
# _run_tests - Master test runner for Pragma-git automated tests
#
# Usage:
#   _run_tests [OPTIONS] [FILTER]
#
# Description:
#   Runs automated regression test suites for Pragma-git (headless / non-GUI).
#   Verifies SSH authentication, remote folder existence and git validation,
#   remote directory creation (including paths with spaces), git client commands,
#   remote file transfers (put/get), and Node.js helper library functions.
#
# Options:
#   -h, --help       Show this help text and exit
#   -v, --verbose    Show detailed live output from each test suite (default is concise)
#   -k, --keep       Preserve temporary test directories in /tmp for visual inspection
#
# Arguments:
#   FILTER           Optional substring to run only matching test suites
#                    (e.g. 'login', 'mkdir', '03', 'git', 'put_get', 'node')
#
# Examples:
#   ./_run_tests                  Run all test suites (cleans up /tmp)
#   ./_run_tests -k               Run all suites and keep test files in /tmp
#   ./_run_tests mkdir            Run only tests matching 'mkdir'
#   ./_run_tests -k git           Run ssh-git-client tests and preserve the repo in /tmp
#   ./_run_tests -v               Run all tests with full verbose output
#
## Help -- prints header above (stops at '##')  (see https://github.com/JanAxelsson/cliHelpLine)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "/?" ]; then sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'; exit 0; fi


SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Styling
BOLD=$(tput bold 2>/dev/null || echo "")
NORMAL=$(tput sgr0 2>/dev/null || echo "")
GREEN=$(tput setaf 2 2>/dev/null || echo "")
RED=$(tput setaf 1 2>/dev/null || echo "")
CYAN=$(tput setaf 6 2>/dev/null || echo "")
YELLOW=$(tput setaf 3 2>/dev/null || echo "")

FILTER=""
VERBOSE=false
KEEP_TEMP=false

for arg in "$@"; do
    case "$arg" in
        -h|--help|'/?')
            sed -e '1{/^#!/d;}' -e '/^##/q' -e '/^[[:space:]]*$/d' -e 's/^#//g' -e 's/^ //g' "$0" | sed '$d'
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            export VERBOSE=true
            ;;
        -k|--keep)
            KEEP_TEMP=true
            export KEEP_TEMP=true
            ;;
        *)
            if [ -z "$FILTER" ]; then
                FILTER="$arg"
            fi
            ;;
    esac
done

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}${CYAN}      Pragma-git Automated Test Suite (Non-GUI / Headless)${NORMAL}"
echo "${BOLD}======================================================================${NORMAL}"
echo "Running on: $(uname -s) ($(uname -m)) as user '$USER'"
echo "Repo root : $REPO_ROOT"
[ -n "$FILTER" ] && echo "Filter    : *${FILTER}*"
[ "$KEEP_TEMP" = true ] && echo "Mode      : Preserving test files in /tmp (--keep)"
[ "$VERBOSE" = true ] && echo "Verbosity : Detailed (-v)"
echo ""

START_TIME=$(date +%s)
TOTAL_SUITES=0
PASSED_SUITES=0
FAILED_SUITES=0

# Find all test files in non_gui/ssh/
ALL_TEST_FILES=$(find "$SCRIPT_DIR/non_gui/ssh" -type f \( -name "test_*.sh" -o -name "test_*.js" \) | sort)

# Pre-filter tests
TEST_FILES=()
for test_path in $ALL_TEST_FILES; do
    test_name=$(basename "$test_path")
    if [ -z "$FILTER" ] || [[ "$test_name" == *"$FILTER"* ]]; then
        TEST_FILES+=("$test_path")
    fi
done

NUM_TESTS=${#TEST_FILES[@]}

if [ "$NUM_TESTS" -eq 0 ]; then
    echo "${YELLOW}No test suites matched filter: *${FILTER}*${NORMAL}"
    exit 0
fi

for test_path in "${TEST_FILES[@]}"; do
    test_name=$(basename "$test_path")
    ((TOTAL_SUITES++))

    if [ "$VERBOSE" = true ]; then
        echo "${BOLD}----------------------------------------------------------------------${NORMAL}"
        echo "${BOLD}>> Suite $TOTAL_SUITES/$NUM_TESTS: ${test_name}${NORMAL}"

        if [[ "$test_path" == *.js ]]; then
            node "$test_path"
        else
            bash "$test_path"
        fi
        exit_code=$?

        if [ $exit_code -eq 0 ]; then
            ((PASSED_SUITES++))
            echo "${GREEN}${BOLD}>> Result: SUITE PASSED [OK]${NORMAL}"
        else
            ((FAILED_SUITES++))
            echo "${RED}${BOLD}>> Result: SUITE FAILED [XX]${NORMAL}"
        fi
        echo ""
    else
        printf ">> [%d/%d] %-38s " "$TOTAL_SUITES" "$NUM_TESTS" "$test_name"

        if [[ "$test_path" == *.js ]]; then
            OUTPUT=$(node "$test_path" 2>&1)
        else
            OUTPUT=$(bash "$test_path" 2>&1)
        fi
        exit_code=$?

        pass_count=$(echo "$OUTPUT" | grep -c '\[PASS\]')
        fail_count=$(echo "$OUTPUT" | grep -c '\[FAIL\]')

        if [ $exit_code -eq 0 ]; then
            ((PASSED_SUITES++))
            echo "${GREEN}[OK]${NORMAL} (${pass_count} passed)"
            if [ "$KEEP_TEMP" = true ]; then
                echo "$OUTPUT" | grep '\[INFO\] Preserved' | sed 's/  \[INFO\]/      /'
            fi
        else
            ((FAILED_SUITES++))
            echo "${RED}[FAILED]${NORMAL} (${fail_count} failed)"
            echo ""
            echo "${RED}${BOLD}--- Failure Output for ${test_name} ---${NORMAL}"
            echo "$OUTPUT"
            echo "${RED}${BOLD}----------------------------------------${NORMAL}"
            echo ""
        fi
    fi
done

[ "$VERBOSE" = false ] && echo ""

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "${BOLD}======================================================================${NORMAL}"
echo "${BOLD}Test Summary:${NORMAL}"
echo "  Suites run:    $TOTAL_SUITES"
echo "  Suites passed: ${GREEN}$PASSED_SUITES${NORMAL}"
if [ $FAILED_SUITES -gt 0 ]; then
    echo "  Suites failed: ${RED}$FAILED_SUITES${NORMAL}"
else
    echo "  Suites failed: $FAILED_SUITES"
fi
echo "  Duration:      ${DURATION}s"
echo "${BOLD}======================================================================${NORMAL}"

if [ "$KEEP_TEMP" = true ]; then
    echo ""
    echo "${CYAN}${BOLD}Preserved test directories in /tmp for visual inspection:${NORMAL}"
    ls -ld /tmp/pragma_* 2>/dev/null || echo "  (None found)"
    echo ""
    echo "  ${YELLOW}* To inspect in Finder : open /tmp${NORMAL}"
    echo "  ${YELLOW}* To clean up when done: rm -rf /tmp/pragma_*${NORMAL}"
    echo ""
fi

if [ $FAILED_SUITES -eq 0 ] && [ $TOTAL_SUITES -gt 0 ]; then
    echo "${GREEN}${BOLD}ALL TESTS PASSED!${NORMAL}"
    exit 0
else
    echo "${RED}${BOLD}SOME TESTS FAILED!${NORMAL}"
    exit 1
fi
