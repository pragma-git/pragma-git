#!/bin/bash
#
# 1) Normally runs on local PC.  
#
# 2) If connected over ssh to a folder, and working with git there, it will start with $5 == 'ssh'
#    Pragma-git will in this case get the files from the server, and open a local pragma-merge ( $5 is not set on the local instance)
#
# 3) For ssh to a folder on Windows, this runs over WSL.  Hence special WSL if statements

LOG_INDENT=""

# Home dir
if [ -n "$PRAGMA_SIGNAL_DIR" ]; then
    TMP="$PRAGMA_SIGNAL_DIR"
    MERGE_LOG="$TMP/mergelog.txt"
    date > "$MERGE_LOG" 2>/dev/null || true
elif [ -z ${SYSTEMDRIVE+x} ]
then
    # Mac or Linux or WSL 
    TMP="$HOME/.Pragma-git/.tmp"
    MERGE_LOG="$TMP/mergelog.txt"
    date > "$MERGE_LOG"
    
    # Modify TMP if run under WSL
    # Windows (git over ssh is implemented using WSL)
	if grep -qEi "(Microsoft|WSL)" /proc/version &> /dev/null; then
		# 1. Fast path: assume WSL username matches Windows username (/home/<user> -> /mnt/c/Users/<user>, 0 ms)
		WIN_WSL_PROFILE=""
		if [[ "$HOME" == /home/* ]]; then
			WIN_WSL_PROFILE="${HOME/\/home/\/mnt\/c\/Users}"
		fi

		# 2. Fallback for username mismatch or root: read cached Windows profile or query cmd.exe once
		if [ -z "$WIN_WSL_PROFILE" ] || [ ! -d "$WIN_WSL_PROFILE/.Pragma-git" ]; then
			PROFILE_CACHE="/tmp/pragma_win_profile"
			if [ -f "$PROFILE_CACHE" ]; then
				WIN_WSL_PROFILE=$(<"$PROFILE_CACHE")
			fi
			if [ -z "$WIN_WSL_PROFILE" ] || [ ! -d "$WIN_WSL_PROFILE" ]; then
				WIN_USER_PROFILE=$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r\n')
				if [ -n "$WIN_USER_PROFILE" ]; then
					WIN_WSL_PROFILE=$(wslpath -u "$WIN_USER_PROFILE" 2>/dev/null)
					if [ -n "$WIN_WSL_PROFILE" ] && [ -d "$WIN_WSL_PROFILE" ]; then
						echo "$WIN_WSL_PROFILE" > "$PROFILE_CACHE" 2>/dev/null
					fi
				fi
			fi
		fi

		if [ -n "$WIN_WSL_PROFILE" ] && [ -d "$WIN_WSL_PROFILE" ]; then
			TMP="$WIN_WSL_PROFILE/.Pragma-git/.tmp"
		fi

		if [ ! -d "$(dirname "$TMP")" ]; then
			TMP="$HOME/.Pragma-git/.tmp"
		fi
		
		MERGE_LOG="${TMP}/mergelog.txt"
        date > "$MERGE_LOG"
		LOG_INDENT="   "
		echo ">> PRAGMA-MERGE  $@" >> "$MERGE_LOG"
		echo "${LOG_INDENT}Running in WSL" >> "$MERGE_LOG"
	else
		 # Must be without git over ssh -- restart log
		 echo "Mac or Linux or WSL" >> "$MERGE_LOG"
	fi
    
   
    
    #env >> "$MERGE_LOG"
    echo $(pwd) > "$TMP/repo_path"
    echo "${LOG_INDENT}TMP=$TMP" >> "$MERGE_LOG"
else
    # Windows
    TMP="$USERPROFILE/.Pragma-git/.tmp"  # Must be without git over ssh -- restart log		
    MERGE_LOG="${TMP}/mergelog.txt"
    date > "$MERGE_LOG"
    
    echo "${LOG_INDENT}WINDOWS" >> "$MERGE_LOG"
    #env >> "$MERGE_LOG"
    echo $(pwd -W) > "$TMP/repo_path"
    echo "${LOG_INDENT}TMP=$TMP" >> "$MERGE_LOG"
fi


echo "x$0x" >> "$MERGE_LOG"
echo "x$1x" >> "$MERGE_LOG"
echo "x$2x" >> "$MERGE_LOG"
echo "x$3x" >> "$MERGE_LOG"
echo "x$4x" >> "$MERGE_LOG"
echo "x$5x" >> "$MERGE_LOG"

mkdir -p "$TMP" 2>/dev/null

# Generate unique session ID and dedicated session folder
SESSION_ID="session_${$}_$(date +%s)"
SESSIONS_DIR="$TMP/sessions"
SESSION_DIR="$SESSIONS_DIR/$SESSION_ID"
mkdir -p "$SESSION_DIR" 2>/dev/null

RUNNING="$TMP/pragma-merge-running"  # Pragma-git looks for this file, and starts Pragma-merge
EXIT="$TMP/exit-pragma-merge"        # Pragma-git closing saves exit-code here, which is transferred to exit code of this script

SESSION_RUNNING="$SESSION_DIR/pragma-merge-running"
SESSION_EXIT="$SESSION_DIR/exit-pragma-merge"

# SSH folder -- special ($5 == 'ssh' or $3 == 'ssh' means that pragma-merge is running on server)
echo "${LOG_INDENT}Argument \$5 = \"$5\", \$3 = \"$3\" (empty if local, 'ssh' if pragma-git from client to ssh folder on this server)" >> "$MERGE_LOG"
if [[ "$5" == "ssh" || "$3" == "ssh" ]] ; then
    FILE_LIST_ON_SSH='/tmp/git_diff_file_list.txt' 
    RUNNING="$TMP/pragma-merge-running-ssh"  # Pragma-git looks for this file, and starts Pragma-merge
    SESSION_RUNNING="$SESSION_DIR/pragma-merge-running-ssh"
fi

if [[ "$5" == "ssh" || "$3" == "ssh" ]] ; then
    # SSH folder -- special inventory to be picked up from server (this) by client (connecting to here with ssh)
    echo "\"$1\" \"$2\" \"$3\" \"$4\" $5" >>  "$MERGE_LOG" 
    echo "\"$1\" \"$2\" \"$3\" \"$4\"" > "$FILE_LIST_ON_SSH"  # Store all input parameters for Pragma-git to pick up 
    echo "\"$1\" \"$2\" \"$3\" \"$4\"" > "$SESSION_DIR/file_list.txt"
fi

# If started in WSL -- need to transform to Window file paths in signalling files
if grep -qEi "(Microsoft|WSL)" /proc/version &> /dev/null; then
	# Rewrite positional parameters $1, .. $4
	set -e -- \
		"$(echo "$1" | sed 's|/mnt/c|C:|')" \
		"$(echo "$2" | sed 's|/mnt/c|C:|')" \
		"$(echo "$3" | sed 's|/mnt/c|C:|')" \
		"$(echo "$4" | sed 's|/mnt/c|C:|')" 

fi


# Store input parameters in both legacy location and dedicated session directory
echo "$1" > "$TMP/first"
echo "$2" > "$TMP/second"
echo "$3" > "$TMP/third"
echo "$4" > "$TMP/fourth"    

echo "$1" > "$SESSION_DIR/first"
echo "$2" > "$SESSION_DIR/second"
echo "$3" > "$SESSION_DIR/third"
echo "$4" > "$SESSION_DIR/fourth"
echo "$SESSION_ID" > "$SESSION_DIR/session_id"
echo "$SESSION_ID" > "$TMP/last_session_id"

# Run Pragma-merge while running signal file exists in session directory
echo  " " >> "$MERGE_LOG"

touch "$SESSION_RUNNING"

while [ -f "$SESSION_RUNNING" ]
do
  sleep 1 
done

# Exited Pragma-merge
if [[ "$5" == "ssh" || "$3" == "ssh" ]] ; then
    rm -f "$FILE_LIST_ON_SSH" 2>/dev/null
fi

# Resolve exit code from session exit file
if [ -f "$SESSION_EXIT" ]; then
    EXITCODE=$(cat "$SESSION_EXIT")
elif [ -f "$EXIT" ]; then
    EXITCODE=$(cat "$EXIT")
else
    EXITCODE=0
fi

# Clean up session directory
rm -rf "$SESSION_DIR" 2>/dev/null

echo  " " >> "$MERGE_LOG"
echo  "${LOG_INDENT}EXIT pragma-merge" >> "$MERGE_LOG"
echo  "${LOG_INDENT}EXIT_CODE = $EXITCODE" >> "$MERGE_LOG"

echo  " " >> "$MERGE_LOG"

exit $EXITCODE
