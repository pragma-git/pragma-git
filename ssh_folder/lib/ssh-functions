#!/bin/bash 
#
# This is the standard way for all ssh-functions to get constants, and functions
#
# The function "getSshUrlParts" is important for all ssh-functions, since it splits the SSHURL into parts
# NOTE: None of the ssh-functions in this file should print anything to stdout (because it may break pragma-git)

ISWSL=false

# Mac or Linux  
TMP="$HOME/.Pragma-git/.tmp"	# /home/jan
CONTROLPATH="${TMP}/%r@%h:%p"	# Controlpath in "$HOME/.Pragma-git/.tmp"
TEMP_FILE_LOCATION='/tmp/pragma-git-ssh-folders'          # Download folder temporary files (same path defined in pragma-merge.js)

# Windows (git over ssh  is implemented using WSL)
if grep -qEi "(Microsoft|WSL)" /proc/version &> /dev/null; then

	ISWSL=true

    # Make paths for running inside WSL
    TMP="${TMP/\/home/\/mnt\/c\/Users}" # Transform /home/jan/.Pragma-git/.tmp => /mnt/c/Users/jan/.Pragma-git/.tmp  
	CONTROLPATH="${HOME}/%r@%h:%p"      # Sockets must be in native linux, not a mount points /mnt/c/... . Use  "$HOME/"
	
	TEMP_FILE_LOCATION="${HOME/\/home/\/mnt\/c\/Users}"
	TEMP_FILE_LOCATION="${TEMP_FILE_LOCATION}/AppData/Local/Temp/pragma-git-ssh-folders"
	if [ ! -d "$TEMP_FILE_LOCATION" ]; then
		mkdir -p "$TEMP_FILE_LOCATION"
	fi
	
	
fi

# SSH AND SCP OPTIONS
TIMEOUT="1"   # SSH TIMEOUT
CONNECT_OPTIONS=" -4 -o ConnectTimeout=${TIMEOUT}  -o PreferredAuthentications=publickey -o PasswordAuthentication=no -o StrictHostKeyChecking=no " # Connecting
REUSE_SSH_OPTIONS=" -o ControlMaster=auto -o ControlPersist=1m -o ControlPath=${CONTROLPATH} "  # Reuse ssh channel (speed up )

# Combine connection and reuse options  
SSH_OPTIONS="${CONNECT_OPTIONS} ${REUSE_SSH_OPTIONS}"

SSH_LOG="${TMP}/ssh-log.log"
MERGE_LOG="$TMP/mergelog.txt"

