# Optimized version with DeepSeek
function getSshUrlParts() {
    # Input: SSH URL in format "ssh://[user@]host[:port][/path]"
    # Output: Sets global variables SERVER, PORT, and SERVER_BASE_PATH
    
    local url="$1"
    local temp server_part path_part

    # Step 1: Remove 'ssh://' prefix
    # Example: "ssh://user@host:42/path" → "user@host:42/path"
    temp="${url#ssh://}"

    # Step 2: Extract server part (before first slash) and path part (after first slash)
    # Example: "user@host:42/path" → server_part="user@host:42", path_part="path"
    if [[ "$temp" == */* ]]; then
        server_part="${temp%%/*}"  # Greedy match until first /
        path_part="${temp#*/}"      # Everything after first /
    else
        server_part="$temp"
        path_part=""
    fi

    # Step 3: Handle trailing colon case (URLs like "ssh://user@host:/path")
    # Example: "user@host:" → "user@host"
    server_part="${server_part%:}"

    # Step 4: Split server and port
    if [[ "$server_part" == *:* ]]; then
        # Example: "user@host:42" → SERVER="user@host", PORT="42"
        SERVER="${server_part%:*}"  # Remove everything after last :
        PORT="${server_part##*:}"   # Extract text after last :
        
        # Handle case where colon exists but port is empty
        # Example: "user@host:" → PORT="22"
        [[ -z "$PORT" ]] && PORT=22
    else
        SERVER="$server_part"
        PORT=22
    fi

    # Step 5: Format server base path (ensure absolute path)
    # - Empty path becomes "/"
    # - Existing paths get leading slash: "path" → "/path"
    SERVER_BASE_PATH="/${path_part}"
    
    #echo "SERVER = $SERVER" >> "$MERGE_LOG"
    #echo "PORT = $PORT" >> "$MERGE_LOG"
    #echo "SERVER_BASE_PATH = $SERVER_BASE_PATH" >> "$MERGE_LOG"
}
