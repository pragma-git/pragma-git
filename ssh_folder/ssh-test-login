#!/bin/bash
# Tests if passwordless SSH login is working
# Usage: ./ssh-test-login <SSH_URL>
# Example: ./ssh-test-login ssh://jan@localhost/
# Example: PRAGMA_SSH_KEY=~/.ssh/id_rsa_jans_mac ./ssh-test-login ssh://jan@localhost/
#
# The key is selected centrally in lib/ssh-functions (environment variable PRAGMA_SSH_KEY => SSH_KEY_OPTIONS)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/ssh-functions"

getSshUrlParts "$1"

# Check for missing server
if [ -z "$SERVER" ]; then
    echo "STATUS:ERROR: Missing host/server in SSH URL"
    exit 0
fi

# Check that selected key exists (on Windows: mirrored into WSL ~/.ssh by ssh-sync-keys)
if [ -n "$SSH_KEY_PATH" ] && [ ! -f "$SSH_KEY_PATH" ]; then
    echo "STATUS:KEY_NEEDED"
    exit 0
fi

# Run ssh with publickey authentication only, timeout 4 seconds (no connection reuse -- test a fresh login)
OUTPUT=$(ssh $SSH_KEY_OPTIONS -T "$SERVER" -p ${PORT} -o BatchMode=yes -o ConnectTimeout=4 -o PreferredAuthentications=publickey -o PasswordAuthentication=no -o StrictHostKeyChecking=no "echo PRAGMA_SSH_OK" 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ] && echo "$OUTPUT" | grep -q "PRAGMA_SSH_OK"; then
    echo "STATUS:OK"
    exit 0
elif echo "$OUTPUT" | grep -qi "permission denied"; then
    echo "STATUS:KEY_NEEDED"
    exit 0
elif echo "$OUTPUT" | grep -qi "timed out"; then
    echo "STATUS:TIMEOUT"
    exit 0
elif echo "$OUTPUT" | grep -qi "could not resolve"; then
    echo "STATUS:ERROR: Could not resolve hostname ($SERVER)"
    exit 0
elif echo "$OUTPUT" | grep -qi "connection refused"; then
    echo "STATUS:ERROR: Connection refused on port ${PORT}"
    exit 0
else
    # Clean output to one line
    CLEAN_OUTPUT=$(echo "$OUTPUT" | tr '\n' ' ' | sed 's/  */ /g' | cut -c 1-80)
    echo "STATUS:ERROR: $CLEAN_OUTPUT"
    exit 0
fi
