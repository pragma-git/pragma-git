#!/bin/bash
# Tests if passwordless SSH login is working
# Usage: ./ssh-test-login <SSH_URL> [KEY_PATH]
# Example: ./ssh-test-login ssh://jan@localhost/
# Example: ./ssh-test-login ssh://jan@localhost/ ~/.ssh/id_rsa_jans_mac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/ssh-functions"

getSshUrlParts "$1"

KEY_OPT=""
if [ -n "$2" ]; then
    KEY_INPUT="$2"
    # Support Windows paths when running inside WSL (e.g. C:\... or C:/...)
    if [[ "$KEY_INPUT" =~ ^[a-zA-Z]:[/\\] ]]; then
        DRIVE_LETTER="$(echo "${KEY_INPUT:0:1}" | tr '[:upper:]' '[:lower:]')"
        REST="${KEY_INPUT:2}"
        REST="${REST//\\//}"
        KEY_PATH="/mnt/${DRIVE_LETTER}${REST}"
    elif [[ "$KEY_INPUT" == /* ]]; then
        KEY_PATH="$KEY_INPUT"
    elif [[ "$KEY_INPUT" == ~* ]]; then
        KEY_PATH="${KEY_INPUT/#\~/$HOME}"
    else
        # If running inside WSL, check Windows user profile ~/.ssh first if key exists there
        if [ "$ISWSL" = true ] && [ -n "$WIN_WSL_PROFILE" ] && [ -f "$WIN_WSL_PROFILE/.ssh/$KEY_INPUT" ]; then
            KEY_PATH="$WIN_WSL_PROFILE/.ssh/$KEY_INPUT"
        else
            KEY_PATH="$HOME/.ssh/$KEY_INPUT"
        fi
    fi
    KEY_PATH="${KEY_PATH%.pub}"

    # Also fallback to Windows profile .ssh in WSL if path under Linux $HOME doesn't exist
    if [ ! -f "$KEY_PATH" ] && [ "$ISWSL" = true ] && [ -n "$WIN_WSL_PROFILE" ]; then
        BASE_KEY="$(basename "$KEY_PATH")"
        if [ -f "$WIN_WSL_PROFILE/.ssh/$BASE_KEY" ]; then
            KEY_PATH="$WIN_WSL_PROFILE/.ssh/$BASE_KEY"
        fi
    fi

    if [ -f "$KEY_PATH" ]; then
        KEY_OPT="-i $KEY_PATH -o IdentitiesOnly=yes"
    fi
fi

# Check for missing server
if [ -z "$SERVER" ]; then
    echo "STATUS:ERROR: Missing host/server in SSH URL"
    exit 0
fi

# Run ssh with publickey authentication only, timeout 4 seconds
OUTPUT=$(ssh $KEY_OPT -T "$SERVER" -p ${PORT} -o BatchMode=yes -o ConnectTimeout=4 -o PreferredAuthentications=publickey -o PasswordAuthentication=no -o StrictHostKeyChecking=no "echo PRAGMA_SSH_OK" 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ] && echo "$OUTPUT" | grep -q "PRAGMA_SSH_OK"; then
    echo "STATUS:OK"
    exit 0
elif echo "$OUTPUT" | grep -qi "permission denied"; then
    echo "STATUS:KEY_NEEDED"
    exit 0
elif echo "$OUTPUT" | grep -qi "timed out"; then
    echo "STATUS:TIMEOUT"
    exit 0
elif echo "$OUTPUT" | grep -qi "could not resolve"; then
    echo "STATUS:ERROR: Could not resolve hostname ($SERVER)"
    exit 0
elif echo "$OUTPUT" | grep -qi "connection refused"; then
    echo "STATUS:ERROR: Connection refused on port ${PORT}"
    exit 0
else
    # Clean output to one line
    CLEAN_OUTPUT=$(echo "$OUTPUT" | tr '\n' ' ' | sed 's/  */ /g' | cut -c 1-80)
    echo "STATUS:ERROR: $CLEAN_OUTPUT"
    exit 0
fi
