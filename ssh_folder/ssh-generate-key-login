#!/bin/bash

###############################################################################
#  PURPOSE:
#    - Generate a new SSH keypair (default: ED25519, no passphrase)
#    - Detect if the remote server supports post‑quantum (PQ) key exchange
#    - If not, fall back to safe traditional KEX to avoid warnings
#    - Securely copy the public key without ssh-copy-id
#    - Install the key on the remote host with correct permissions
#    - Do NOT overwrite existing local SSH keys
#    - Do NOT insert duplicate keys into authorized_keys
#    - Provide clear logging for every condition
#
#  USAGE:
#       ./ssh-generate-key-login <remote-user> <remote-host> [keyname_name]
#
#  EXAMPLE:
#       ./ssh-generate-key-login alice server.example.com mykey_name
###############################################################################

REMOTE_USER="$1"
REMOTE_HOST="$2"
KEY_NAME="${3:-id_ed25519}"          # default key name
KEY_PATH="$HOME/.ssh/$KEY_NAME"

if [ -z "$REMOTE_USER" ] || [ -z "$REMOTE_HOST" ]; then
    echo "Usage: $0 <remote-user> <remote-host> [keyname]"
    exit 1
fi

###############################################################################
# Generate SSH key pair (skip if it already exists)
###############################################################################
echo "==> Checking local SSH key..."

if [ -e "$KEY_PATH" ]; then
    echo "==> Local key '$KEY_PATH' already exists — NOT overwriting."
else
    echo "==> Generating new SSH key pair (no passphrase)…"
    ssh-keygen -t ed25519 -f "$KEY_PATH" -N ""
fi

###############################################################################
# Detect PQ KEX support
###############################################################################
echo "==> Checking remote server for post-quantum KEX support…"

SSH_VERSION_OUTPUT=$(ssh -o BatchMode=yes -o ConnectTimeout=5 \
    "$REMOTE_USER@$REMOTE_HOST" "ssh -V" 2>&1)

REMOTE_SSH_VERSION=$(echo "$SSH_VERSION_OUTPUT" | grep -oE 'OpenSSH_([0-9]+\.[0-9]+)' | cut -d_ -f2)

USE_LEGACY_KEX="no"

if [ -n "$REMOTE_SSH_VERSION" ]; then
    REMOTE_MAJOR=$(echo "$REMOTE_SSH_VERSION" | cut -d. -f1)
    REMOTE_MINOR=$(echo "$REMOTE_SSH_VERSION" | cut -d. -f2)

    if (( REMOTE_MAJOR < 9 )); then
        USE_LEGACY_KEX="yes"
    fi
else
    echo "   Could not detect remote OpenSSH version. Falling back to safe KEX."
    USE_LEGACY_KEX="yes"
fi

if [ "$USE_LEGACY_KEX" = "yes" ]; then
    echo "   -> Remote server does NOT support PQ KEX. Using fallback."
    KEX_OPTS="-o KexAlgorithms=+diffie-hellman-group-exchange-sha256"
else
    echo "   -> Remote server supports PQ KEX."
    KEX_OPTS=""
fi

###############################################################################
# Prepare remote ~/.ssh directory
###############################################################################
echo "==> Ensuring ~/.ssh exists on remote host…"

ssh $KEX_OPTS "$REMOTE_USER@$REMOTE_HOST" \
    "mkdir -p ~/.ssh && chmod 700 ~/.ssh"

###############################################################################
# Copy public key via SCP
###############################################################################
echo "==> Uploading public key to remote host…"

scp $KEX_OPTS "${KEY_PATH}.pub" \
    "${REMOTE_USER}@${REMOTE_HOST}:/tmp/remote_tmp_key.pub"

###############################################################################
# Install key on remote server safely (no duplicates, with logging)
###############################################################################
echo "==> Installing public key on remote host…"

ssh $KEX_OPTS "$REMOTE_USER@$REMOTE_HOST" "
    touch ~/.ssh/authorized_keys &&
    chmod 600 ~/.ssh/authorized_keys &&
    PUBKEY_CONTENT=\$(cat /tmp/remote_tmp_key.pub)

    if grep -qxF \"\$PUBKEY_CONTENT\" ~/.ssh/authorized_keys; then
        echo '   -> Key is already present on remote server — no update needed.'
    else
        echo \"\$PUBKEY_CONTENT\" >> ~/.ssh/authorized_keys
        echo '   -> Key added to remote authorized_keys.'
    fi

    rm /tmp/remote_tmp_key.pub
"

###############################################################################
echo "==> ✔ DONE!"
echo "Local key path: $KEY_PATH"
echo "You can now log in without a password:"
echo "  ssh $KEX_OPTS $REMOTE_USER@$REMOTE_HOST"
###############################################################################
``
